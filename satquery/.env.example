# SatQuery AI — Environment Configuration
# Copy this to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────
# HuggingFace token (for gated models)
HF_TOKEN=

# ── Model flags (set to false to skip loading on CPU-only machines) ──────────
LOAD_VQA_MODEL=true
LOAD_CAPTION_MODEL=true
LOAD_GROUNDING_MODEL=true
LOAD_CHANGE_MODEL=true
LOAD_SAR_MODEL=true

# ── Storage ───────────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=100
